{
  "name": "lum",
  "description": "Lum 是一款 AI 短剧漫剧工具，能够利用 AI 技术将小说自动转化为剧本，并结合 AI 生成的图片和视频，实现高效的短剧创作。",
  "author": "HBAI-Ltd <ltlctools@outlook.com>",
  "license": "MIT",
  "homepage": "https://github.com/ZxzZhao6668/Lum-OpenSource#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZxzZhao6668/Lum-OpenSource.git"
  },
  "bugs": {
    "url": "https://github.com/ZxzZhao6668/Lum-OpenSource/issues",
    "email": "ltlctools@outlook.com"
  },
  "type": "module",
  "packageManager": "bun@1.4.3",
  "overrides": {
    "@toonflow/asr": "file:./packages/asr",
    "@toonflow/assets": "file:./packages/assets",
    "@toonflow/ext-scaffold": "file:./packages/extScaffold",
    "@toonflow/ffmpeg": "file:./packages/ffmpeg",
    "@toonflow/file": "file:./packages/file",
    "@toonflow/i18n": "file:./packages/i18n",
    "@toonflow/mcp": "file:./packages/mcp",
    "@toonflow/model-icons": "file:./packages/modelIcons",
    "@toonflow/node-audio": "file:./packages/nodes/audioNode",
    "@toonflow/node-image": "file:./packages/nodes/imageNode",
    "@toonflow/node-shared": "file:./packages/nodeShared",
    "@toonflow/node-text": "file:./packages/nodes/textNode",
    "@toonflow/node-video": "file:./packages/nodes/videoNode",
    "@toonflow/nodes-scaffold": "file:./packages/nodeScaffold",
    "@toonflow/providers": "file:./packages/providers",
    "@toonflow/server": "file:./apps/server",
    "@toonflow/startup": "file:./packages/startup",
    "@toonflow/teams-scaffold": "file:./packages/teamScaffold",
    "@toonflow/tool-asset-operator": "file:./packages/tools/assetOperator",
    "@toonflow/tool-browser": "file:./packages/tools/browser",
    "@toonflow/tool-canvas": "file:./packages/tools/canvas",
    "@toonflow/tool-sandbox": "file:./packages/tools/sandbox",
    "@toonflow/tools-scaffold": "file:./packages/toolScaffold",
    "@toonflow/web": "file:./apps/web"
  },
  "patchedDependencies": {
    "@vue-flow/core@1.48.2": "patches/vueFlowCore.patch",
    "@earendil-works/pi-agent-core@0.85.1": "patches/piAgentCore.patch",
    "@earendil-works/pi-coding-agent@0.85.1": "patches/piCodingAgent.patch"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/nodes/*",
    "packages/tools/*",
    "packages/teams/*",
    "packages/ext/*"
  ],
  "scripts": {
    "dev": "bun run --filter '@lum/web' --filter '@lum/server' dev",
    "dev:web": "bun run --filter '@lum/web' dev",
    "dev:server": "bun run --filter '@lum/server' dev",
    "dev:desktop": "bun run --filter '@lum/desktop' dev",
    "dev:plugins": "NODE_ENV=dev bun run --filter './packages/tools/*' --filter './packages/nodes/*' --filter './packages/ext/*' build",
    "dev:updateServer": "bun run --filter '@lum/updateServer' dev",
    "start:updateServer": "bun run --filter '@lum/updateServer' start",
    "publish:update": "bun run apps/updateServer/scripts/publish.ts",
    "start:server": "bun run --cwd apps/server start",
    "build:server": "bun apps/server/scripts/buildStandalone.ts",
    "build": "bun run build:tools && bun run build:ext && bun run --filter '@lum/web' --filter '@lum/server' build",
    "build:nodes": "bun -e \"import { rmSync } from '@lum/file'; import { resolve } from 'node:path'; rmSync(resolve('build/nodes'), { recursive: true, force: true });\" && NODE_ENV=production bun run --filter './packages/nodes/*' build",
    "create:ext": "bun packages/extScaffold/create.ts",
    "build:ext": "bun -e \"import { rmSync } from '@lum/file'; import { resolve } from 'node:path'; rmSync(resolve('build/ext'), { recursive: true, force: true });\" && NODE_ENV=production bun run --filter './packages/ext/*' build",
    "build:desktop": "bun run --filter '@lum/desktop' build",
    "build:mcp": "bun run --filter '@lum/mcp' build",
    "build:teams": "NODE_ENV=production bun run --filter './packages/teams/*' build",
    "package:desktop": "bun run --filter '@lum/desktop' package",
    "release:desktop": "bun run apps/desktop/scripts/release.ts",
    "typecheck": "bun run --filter '@lum/*' typecheck",
    "build:tools": "bun -e \"import { rmSync } from '@lum/file'; import { resolve } from 'node:path'; rmSync(resolve('build/tools'), { recursive: true, force: true });\" && NODE_ENV=production bun run --filter './packages/tools/*' build"
  },
  "devDependencies": {
    "@toonflow/asr": "workspace:@lum/asr@*",
    "@toonflow/assets": "workspace:@lum/assets@*",
    "@toonflow/ext-scaffold": "workspace:@lum/ext-scaffold@*",
    "@toonflow/ffmpeg": "workspace:@lum/ffmpeg@*",
    "@toonflow/file": "workspace:@lum/file@*",
    "@toonflow/i18n": "workspace:@lum/i18n@*",
    "@toonflow/mcp": "workspace:@lum/mcp@*",
    "@toonflow/model-icons": "workspace:@lum/model-icons@*",
    "@toonflow/node-audio": "workspace:@lum/node-audio@*",
    "@toonflow/node-image": "workspace:@lum/node-image@*",
    "@toonflow/node-shared": "workspace:@lum/node-shared@*",
    "@toonflow/node-text": "workspace:@lum/node-text@*",
    "@toonflow/node-video": "workspace:@lum/node-video@*",
    "@toonflow/nodes-scaffold": "workspace:@lum/nodes-scaffold@*",
    "@toonflow/providers": "workspace:@lum/providers@*",
    "@toonflow/server": "workspace:@lum/server@*",
    "@toonflow/startup": "workspace:@lum/startup@*",
    "@toonflow/teams-scaffold": "workspace:@lum/teams-scaffold@*",
    "@toonflow/tool-asset-operator": "workspace:@lum/tool-asset-operator@*",
    "@toonflow/tool-browser": "workspace:@lum/tool-browser@*",
    "@toonflow/tool-canvas": "workspace:@lum/tool-canvas@*",
    "@toonflow/tool-sandbox": "workspace:@lum/tool-sandbox@*",
    "@toonflow/tools-scaffold": "workspace:@lum/tools-scaffold@*",
    "@toonflow/web": "workspace:@lum/web@*",
    "@lum/file": "workspace:*",
    "@types/bun": "^1.4.2",
    "@types/postcss-pxtorem": "^6.1.0",
    "postcss": "^8.5.28",
    "postcss-pxtorem": "^6.1.0",
    "typescript": "^7.0.2"
  }
}
